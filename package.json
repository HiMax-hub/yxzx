{
  "name": "yanxun-crm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "build": "tsc --noEmit && vite build",
    "build:prod": "tsc --noEmit && vite build --mode production",
    "lint": "tsc --noEmit",
    "test:smoke": "esbuild scripts/smoke-test.ts --bundle --platform=node --format=esm --outfile=scripts/smoke-test.mjs --log-level=warning && node scripts/smoke-test.mjs",
    "test:security": "esbuild scripts/superadmin-reset-test.ts --bundle --platform=node --format=esm --outfile=scripts/superadmin-reset-test.mjs --log-level=warning && node scripts/superadmin-reset-test.mjs",
    "test": "npm run test:smoke && npm run test:security"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
