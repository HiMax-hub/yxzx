# ============ 生产环境配置模板（复制为 .env.production 并按实际部署环境修改） ============
# 注意：本文件不含敏感信息，可安全提交；真实密钥请放入部署流水线 Secret 中注入。

# 应用运行环境标识
VITE_APP_ENV=production

# 应用名称与版本（展示用）
VITE_APP_NAME=雁讯咨询贷款CRM与业务工作台
VITE_APP_VERSION=1.0.0

# 业务数据 localStorage 前缀（升级数据结构时 bump 版本号）
VITE_STORAGE_PREFIX=yanxun_crm_v5_

# ---- 后端 API / 数据库对接（当前为纯前端 localStorage 模式，接入后端时填写）----
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=15000

# ---- 站点域名（CDN / 反向代理注入）----
VITE_SITE_DOMAIN=
